{
  "manifest_version": 3,
  "name": "LeanVault (Development)",
  "short_name": "LeanVault",
  "description": "A lightweight, open-source client for Vaultwarden-compatible servers.",
  "version": "0.4.0",
  "minimum_chrome_version": "120",
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "LeanVault"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting", "offscreen", "alarms", "clipboardWrite", "favicon"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
